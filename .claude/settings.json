{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/require_worktree.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
